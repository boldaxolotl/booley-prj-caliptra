        file_type: systemVerilogSource
    - src/integration/test_suites/libs/jtagdpi/jtagdpi.sv:
        file_type: systemVerilogSource
    - src/integration/tb/caliptra_top_tb.sv:
        file_type: systemVerilogSource
    tags:
    - tb
  tb_headers:
    files:
    - src/integration/tb/dasm.svi:
        file_type: systemVerilogSource
        is_include_file: true
    - src/integration/tb/dma_transfer_randomizer.sv:
        file_type: systemVerilogSource
        is_include_file: true
    - src/entropy_src/tb/entropy_src_tb.sv:
        file_type: systemVerilogSource
        is_include_file: true
    tags:
    - tb
  vlt:
    files:
    - src/caliptra_prim/lint/caliptra_prim_onehot_check.vlt:
        file_type: vlt
    - src/caliptra_prim/lint/caliptra_prim_arbiter.vlt:
        file_type: vlt
    - src/csrng/lint/csrng.vlt:
        file_type: vlt
    - src/caliptra_prim/lint/caliptra_prim_max_tree.vlt:
        file_type: vlt
    - src/caliptra_prim/lint/caliptra_prim_sum_tree.vlt:
        file_type: vlt
  tb_cpp:
    files:
    - .booley_project/generated/test_caliptra_top_tb.cpp:
        file_type: cppSource
    - src/integration/test_suites/libs/jtagdpi/jtagdpi.c:
        file_type: cSource
    - src/integration/test_suites/libs/tcp_server/tcp_server.c:
        file_type: cSource
    - src/integration/test_suites/libs/jtagdpi/jtagdpi.h:
        file_type: cSource
        is_include_file: true
    - src/integration/test_suites/libs/tcp_server/tcp_server.h:
        file_type: cSource
        is_include_file: true
    tags:
    - tb
targets:
  sim_caliptra:
    flow: sim
    flow_options:
      tool: verilator
      booley:
        doctor:
        - sim
      verilator_options:
      - +define+RV_OPENSOURCE
      - +define+CALIPTRA_INTERNAL_TRNG
      - +define+CALIPTRA_TOP_TB
      - +define+CALIPTRA_TOP=caliptra_top_tb
      - +define+RV_TOP=caliptra_top_tb.caliptra_top_dut.rvtop
      - --timing
      - --exe
      - --timescale
      - 1ns/100ps
      - --autoflush
      - -Wno-WIDTH
      - -Wno-UNOPTFLAT
      - -Wno-LITENDIAN
      - -Wno-CMPCONST
      - -Wno-MULTIDRIVEN
      - -Wno-UNPACKED
      - -Wno-LATCH
      - -Wno-fatal
    filesets:
    - design
    - tb
    - tb_headers
    - vlt
    - tb_cpp
    toplevel: caliptra_top_tb
  lint_caliptra:
    flow: lint
    flow_options:
      tool: verilator
      booley:
        doctor:
        - lint
      verilator_options:
      - +define+RV_OPENSOURCE
      - +define+CALIPTRA_INTERNAL_TRNG
      - +define+CALIPTRA_TOP_TB
      - +define+CALIPTRA_TOP=caliptra_top_tb
      - +define+RV_TOP=caliptra_top_tb.caliptra_top_dut.rvtop
      - --timing
      - -Wno-WIDTH
      - -Wno-UNOPTFLAT
      - -Wno-LITENDIAN
      - -Wno-CMPCONST
      - -Wno-MULTIDRIVEN
      - -Wno-UNPACKED
      - -Wno-LATCH
      - -Wno-fatal
    filesets:
    - design
    - tb
    - tb_headers
    - vlt
    toplevel: caliptra_top_tb
