        file_type: systemVerilogSource
    - src/keyvault/coverage/keyvault_cov_bind.sv:
        file_type: systemVerilogSource
    - submodules/adams-bridge/src/abr_top/coverage/abr_top_cov_if.sv:
        file_type: systemVerilogSource
    - submodules/adams-bridge/src/abr_top/coverage/abr_top_cov_bind.sv:
        file_type: systemVerilogSource
    - src/abr/coverage/clp_abr_top_cov_if.sv:
        file_type: systemVerilogSource
    - src/abr/coverage/clp_abr_top_cov_bind.sv:
        file_type: systemVerilogSource
    - src/axi/coverage/axi_dma_top_cov_if.sv:
        file_type: systemVerilogSource
    - src/axi/coverage/axi_dma_top_cov_bind.sv:
        file_type: systemVerilogSource
    - src/axi/coverage/axi_dma_top_cov_props.sv:
        file_type: systemVerilogSource
    - src/aes/coverage/aes_cov_if.sv:
        file_type: systemVerilogSource
    - src/aes/coverage/aes_cov_bind.sv:
        file_type: systemVerilogSource
    - src/doe/coverage/doe_cov_if.sv:
        file_type: systemVerilogSource
    - src/doe/coverage/doe_cov_bind.sv:
        file_type: systemVerilogSource
    - src/integration/tb/caliptra_top_tb_pkg.sv:
        file_type: systemVerilogSource
    - src/integration/tb/dma_testcase_generator.sv:
        file_type: systemVerilogSource
    - src/integration/tb/caliptra_veer_sram_export.sv:
        file_type: systemVerilogSource
