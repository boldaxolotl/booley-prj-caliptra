        file_type: systemVerilogSource
    - src/soc_ifc/coverage/soc_ifc_cov_if.sv:
        file_type: systemVerilogSource
    - src/soc_ifc/coverage/soc_ifc_iccm_shadow_cov.sv:
        file_type: systemVerilogSource
    - src/soc_ifc/coverage/soc_ifc_cov_bind.sv:
        file_type: systemVerilogSource
    - src/pcrvault/coverage/pcrvault_cov_if.sv:
        file_type: systemVerilogSource
