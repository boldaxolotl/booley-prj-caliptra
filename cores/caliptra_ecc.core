CAPI=2:
name: local:caliptra:ecc:1
description: >-
  Caliptra secp384 ECC engine (ecc_top) at block level. Simulation runs the
  upstream ecc_top_tb; lint and synthesis use the RTL list from
  src/ecc/config/ecc_top.vf with the VF variables resolved
  (CALIPTRA_PRIM_ROOT = src/caliptra_prim_generic, prefix caliptra_prim_generic).
filesets:
  ecc_rtl:
    files:
    - src/keyvault/rtl/kv_macros.svh:
        file_type: systemVerilogSource
        is_include_file: true
    - src/caliptra_prim/rtl/caliptra_prim_assert.sv:
