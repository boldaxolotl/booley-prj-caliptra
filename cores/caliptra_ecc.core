  ecc_tb:
    files:
    - src/integration/rtl/caliptra_reg/caliptra_reg_defines.svh:
        file_type: systemVerilogSource
        is_include_file: true
    - src/integration/rtl/caliptra_reg/caliptra_reg_field_defines.svh:
        file_type: systemVerilogSource
        is_include_file: true
    - src/ecc/coverage/ecc_top_cov_if.sv:
        file_type: systemVerilogSource
    - src/ecc/coverage/ecc_top_cov_bind.sv:
        file_type: systemVerilogSource
    - src/ecc/tb/ecc_top_tb.sv:
        file_type: systemVerilogSource
    tags:
    - tb
  ecc_tb_cpp:
    # C++ main: advances --timing time, traces, and writes coverage.
    files:
    - .booley/sim/ecc_top_tb_main.cpp:
        file_type: cppSource
    tags:
    - tb
  ecc_tb_vectors:
    # The TB opens the file named by +ECC_TEST_VECTOR_FILE, relative to the
    # simulation working directory.
    files:
    - src/ecc/tb/test_vectors/ecc_drbg_mbedtls.hex:
        file_type: user
        copyto: ecc_drbg_mbedtls.hex
    tags:
    - tb
  tech_cells:
    files:
    - .booley/synth/nangate45_icg.sv:
        file_type: systemVerilogSource
  synth_memory:
    files:
    - .booley/synth/ecc_ram_tdp_timing_surrogate.sv:
        file_type: systemVerilogSource
  fau_wrapper:
    files:
    - .booley/synth/ecc_fau_synth_wrapper.sv:
        file_type: systemVerilogSource
  constraints:
    files:
    - .booley/synth/ecc_top.sdc:
        file_type: SDC
targets:
  # Upstream ecc_top_tb on Verilator. Tests (tests.toml): one operation per
  # Test (keygen, sign, verify, ecdh) plus otf_reset, each over the 10
  # shipped vectors; Test Variant "one" runs only the first vector.
  sim_ecc:
    flow: sim
    flow_options:
      tool: verilator
      booley:
        doctor:
        - sim
        coverage:
          reset_included: true
          custom_main_hooks:
          - write_hook
      verilator_options:
      - +define+CLP_ASSERT_ON
      - +define+SIMULATION
      - --timing
      - --exe
      - --timescale
      - 1ns/1ps
      - -Wno-WIDTH
      - -Wno-UNOPTFLAT
      - -Wno-LITENDIAN
      - -Wno-CMPCONST
      - -Wno-MULTIDRIVEN
      - -Wno-UNPACKED
      - -Wno-LATCH
      - -Wno-SIDEEFFECT
    filesets:
    - ecc_rtl
    - ecc_tb
    - ecc_tb_cpp
    - ecc_tb_vectors
    toplevel: ecc_top_tb
    parameters:
    - ECC_TEST_VECTOR_FILE
  # Verilator lint of the ECC RTL alone (no testbench). Upstream RTL has
  # only WIDTH* and CMPCONST warnings, which lint_caliptra also waives.
  lint_ecc:
    flow: lint
    flow_options:
      tool: verilator
      booley:
        doctor:
        - lint
      verilator_options:
      - -Wno-WIDTH
      - -Wno-CMPCONST
    filesets:
    - ecc_rtl
    toplevel: ecc_top
  # Goal A: ecc_top with the operand RAM replaced by the fixed synthesis
  # stand-in (synth/ecc_ram_tdp_timing_surrogate.sv). Same recipe as
  # synth_caliptra; constraints in synth/ecc_top.sdc (clk 20 ns).
  synth_ecc_top:
    flow: generic
    flow_options:
      tool: yosys
      arch: xilinx
      frontend: slang
      synth_mode: physical
      ppa_profile: balanced
      advanced_settings_yosys:
        abc_recipe: fast
      flatten: true
      slang_options:
      - --single-unit
    filesets:
    - ecc_rtl
    - tech_cells
    - synth_memory
    - constraints
    toplevel: ecc_top
    parameters:
    - SYNTHESIS
    - RV_OPENSOURCE
    - CALIPTRA_INTERNAL_TRNG
    - TECH_SPECIFIC_ICG
    - USER_ICG
    - TECH_SPECIFIC_EC_RV_ICG
    - USER_EC_RV_ICG
    - USER_ECC_RAM_TDP
  # Goal B: the field arithmetic unit (Montgomery multiplier + modular
  # adder) through synth/ecc_fau_synth_wrapper.sv, which instantiates ecc_fau
  # exactly as ecc_arith_unit does.
  synth_ecc_fau:
    flow: generic
    flow_options:
      tool: yosys
      arch: xilinx
      frontend: slang
      synth_mode: physical
      ppa_profile: balanced
      advanced_settings_yosys:
        abc_recipe: fast
      flatten: true
      slang_options:
      - --single-unit
    filesets:
    - ecc_rtl
    - fau_wrapper
    - constraints
    toplevel: ecc_fau_synth_wrapper
    parameters:
    - SYNTHESIS
parameters:
  ECC_TEST_VECTOR_FILE:
    datatype: str
    paramtype: plusarg
    default: ecc_drbg_mbedtls.hex
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine
    default: true
  RV_OPENSOURCE:
    datatype: bool
    paramtype: vlogdefine
    default: true
  CALIPTRA_INTERNAL_TRNG:
    datatype: bool
    paramtype: vlogdefine
    default: true
  TECH_SPECIFIC_ICG:
    datatype: bool
    paramtype: vlogdefine
    default: true
  USER_ICG:
    datatype: str
    paramtype: vlogdefine
    default: caliptra_nangate45_icg
  TECH_SPECIFIC_EC_RV_ICG:
    datatype: bool
    paramtype: vlogdefine
    default: true
  USER_EC_RV_ICG:
    datatype: str
    paramtype: vlogdefine
    default: veer_nangate45_icg
  USER_ECC_RAM_TDP:
    datatype: str
    paramtype: vlogdefine
